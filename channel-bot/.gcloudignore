# Uploaded to Cloud Build on `gcloud run deploy --source .`. Everything the
# Dockerfile rebuilds from scratch stays out of the upload (node_modules alone
# is 85M here).
.git
.gitignore
node_modules/
dist/
# Every env file, not just .env: each feed deployed from this directory keeps
# its own (.env.claims, .env.bak), and every one of them holds a bot token.
.env*
*.log
.DS_Store
