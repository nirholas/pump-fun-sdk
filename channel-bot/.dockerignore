# The Dockerfile runs its own `npm install` and `npm run build`, so a host
# node_modules/ or dist/ in the build context is dead weight at best and a
# wrong-architecture binary at worst.
.git
.gitignore
node_modules/
dist/
# Every env file, not just .env: each feed deployed from this directory keeps
# its own (.env.claims, .env.bak), and every one of them holds a bot token.
.env*
*.log
.DS_Store
