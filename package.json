{
  "name": "@nirholas/pump-sdk",
  "version": "1.36.0",
  "description": "TypeScript SDK for the Pump protocol on Solana: token creation, bonding curves, AMM pools, fee sharing, and volume rewards",
  "keywords": [
    "solana",
    "pump",
    "pumpfun",
    "bonding-curve",
    "token",
    "amm",
    "defi",
    "sdk",
    "typescript",
    "mcp",
    "cli",
    "pump-fun-cli",
    "command-line",
    "solana-cli",
    "terminal"
  ],
  "homepage": "https://sdk.pumpk.it",
  "bugs": {
    "url": "https://github.com/nirholas/pump-fun-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nirholas/pump-fun-sdk.git"
  },
  "license": "Apache-2.0",
  "author": "nirholas",
  "engines": {
    "node": ">=18.0.0"
  },
  "main": "./dist/index.js",
  "module": "./dist/esm/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/esm/index.mjs"
    },
    "./*": {
      "types": "./dist/*/index.d.ts",
      "require": "./dist/*/index.js",
      "import": "./dist/*/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "require": "./dist/cli/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup --clean --dts",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:examples": "jest --config jest.examples.config.ts",
    "example": "node scripts/run-example.mjs",
    "build:bundle": "node scripts/build-browser-bundle.mjs",
    "build:site": "node scripts/build-site.mjs",
    "lint": "eslint --cache --quiet \"${@:-.}\"",
    "lint:fix": "eslint --cache --fix --quiet \"${@:-.}\"",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@pump-fun/pump-swap-sdk": "^1.19.0",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.98.4",
    "bn.js": "^5.2.3",
    "bs58": "^6.0.0",
    "commander": "^12.1.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.0",
    "@types/bn.js": "^5.1.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.0.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint-config-flat-gitignore": "^2.1.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-atomic-design-hierarchy": "^1.0.11",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jest": "^28.11.0",
    "eslint-plugin-jsdoc": "^50.6.11",
    "eslint-plugin-no-barrel-files": "^1.2.2",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-unicorn": "^54.0.0",
    "globals": "^15.12.0",
    "jest": "^29.7.0",
    "playwright": "^1.58.2",
    "puppeteer": "^24.38.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "semantic-release": "^25.0.8",
    "ts-jest": "^29.3.2",
    "ts-node": "^10.9.2",
    "tsup": "^8.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.29.1",
    "undici-types": "^6.20.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "release": {
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/npm",
      "@semantic-release/github"
    ],
    "branches": [
      {
        "name": "main"
      },
      {
        "name": "devnet",
        "prerelease": true
      }
    ]
  },
  "bin": {
    "pump": "./dist/cli/index.js"
  }
}
