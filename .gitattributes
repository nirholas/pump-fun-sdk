# Auto detect text files and perform LF normalization
* text=auto

# Markdown
*.md text eol=lf
*.txt text eol=lf

# Shell scripts
*.sh text eol=lf

# JSON
*.json text eol=lf

# YAML
*.yml text eol=lf
*.yaml text eol=lf

# JavaScript/TypeScript
*.js text eol=lf
*.ts text eol=lf
*.jsx text eol=lf
*.tsx text eol=lf

# Python
*.py text eol=lf

# Solidity
*.sol text eol=lf

# SVG
*.svg text eol=lf

# Rust
*.rs text eol=lf
*.toml text eol=lf

# Lock files — do not diff
package-lock.json binary
yarn.lock binary
Cargo.lock binary

# Binary files
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary

# Keypair files should never be committed
*.keypair binary



# ── Linguist ──────────────────────────────────────────────────────────
# GitHub labelled this repo "Rust" because pump-fun-repos/ holds vendored
# upstream sources (carbon, pump-segments-sdk, react-native-pager-view):
# 9.3 MB of third-party .rs, against 5.4 MB of our own TypeScript. Mark
# them vendored so the language bar reflects what this repo actually is.
pump-fun-repos/** linguist-vendored

# Generated and reference material, not authored source.
offline.html linguist-generated
llms-full.txt linguist-generated
docs/** linguist-documentation
tutorials/** linguist-documentation
